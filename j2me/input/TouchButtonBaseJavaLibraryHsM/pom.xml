    <build>
    
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- The GHC version the build uses -->
                    <execution>
                        <id>ghc-version</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${ghc.executable}</executable>
                            <arguments>
                                <argument>--version</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- build.hs runs ghc make mode on every .hs file in this project and the dependency source directories -->
                    <execution>
                        <id>compile-haskell-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${runghc.executable}</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>${project.basedir}/build.hs</argument>
                                <argument>${ghc.executable}</argument>
                                <argument>${haskell.output.dir}</argument>
                                <argument>${haskell.fail.on.error}</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <!-- AllBinary Haskell dependency sources start. Generated by HaskellPOMsGhcBuildUpdater from the pom dependencies nearest first. -->
                                <argument>../../logging/LoggingJ2MEAllHsM/src/main/java</argument>
                                <argument>../../games/GameInputLibraryHsM/src/main/java</argument>
                                <argument>../../../../working_thirdpartyhaskell/embedded/j2me/microemulator/2_0_4/microemu-midpHs/src/main/java</argument>
