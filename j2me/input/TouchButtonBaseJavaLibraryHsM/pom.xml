            </plugin>

            <!-- Package the compiled modules with the other language outputs -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-haskell-modules</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/haskell</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${haskell.output.dir}</directory>
                                    <includes>
                                        <include>**/*.hi</include>
                                        <include>**/*.o</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

