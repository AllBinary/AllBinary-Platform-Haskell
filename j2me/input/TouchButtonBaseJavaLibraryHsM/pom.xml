                                <argument>../../../allbinary_src/LogHsM/src/main/java</argument>
                                <argument>../../EventJ2MELibraryHsM/src/main/java</argument>
                                <argument>../../media/graphics/layer/AllBinaryLayerJavaLibraryHsM/src/main/java</argument>
                                <argument>../../lib/BasicMathLibraryHsM/src/main/java</argument>
                                <argument>../../J2MEUtilJavaLibraryHsM/src/main/java</argument>
                                <argument>../../GroupLibraryHsM/src/main/java</argument>
                                <argument>../../games/GameConfigurationJavaLibraryHsM/src/main/java</argument>
                                <argument>../../../allbinary_src/logic/BasePreloaderJ2MEJavaLibraryHsM/src/main/java</argument>
                                <argument>../../AllBinaryJ2MELibraryHsM/src/main/java</argument>
                                <argument>../../../allbinary_src/ThreadLibraryHsM/src/main/java</argument>
                                <argument>../../../../working_thirdpartyhaskell/embedded/j2me/microemulator/2_0_4/microemu-cldcHs/src/main/java</argument>
                                <argument>../../CommonJavaLibraryHsM/src/main/java</argument>
                                <argument>../../J2MEExceptionLibraryHsM/src/main/java</argument>
                                <argument>../../../replace_these_stub_projects/allbinary_src/J2MEJsInteropCompatibilityJavaLibraryHsM/src/main/java</argument>
                                <argument>../../../allbinary_src/cache/BaseCacheJavaLibraryHsM/src/main/java</argument>
                                <argument>../../../replace_these_stub_projects/allbinary_src/J2MEOnlyJavaLibraryHsM/src/main/java</argument>
                                <argument>../../../graphics/opengl/OpenGLNoneJavaLibraryHsM/src/main/java</argument>
                                <argument>../../../graphics/opengl/OpenGLNoneOtherJavaLibraryHsM/src/main/java</argument>
                                <argument>../../J2MEColorJavaLibraryHsM/src/main/java</argument>
                                <argument>../../logging/LoggingJ2MEExceptionHsM/src/main/java</argument>
                                <argument>../../lib/BaseMathLibraryHsM/src/main/java</argument>
                                <argument>../../../allbinary_src/LogNoPlatformJavaLibraryHsM/src/main/java</argument>
                                <argument>../../../allbinary_src/hardware/NoSystemJavaLibraryHsM/src/main/java</argument>
                                <argument>../../games/GameConfigurationJ2MEJavaLibraryHsM/src/main/java</argument>
